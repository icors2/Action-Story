{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "maps"],
  "properties": {
    "schema_version": { "type": "integer" },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scene"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "scene": { "type": "string" },
          "bounds": {
            "type": "array",
            "items": { "type": "number" }
          },
          "return_map": { "type": "string" },
          "flags": { "type": "object" },
          "spawns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["mob", "marker_group", "max_alive"],
              "properties": {
                "mob": { "type": "string" },
                "marker_group": { "type": "string" },
                "max_alive": { "type": "integer" },
                "respawn_ticks": { "type": "integer" }
              }
            }
          }
        }
      }
    }
  }
}
