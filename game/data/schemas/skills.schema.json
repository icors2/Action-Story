{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": { "type": "integer" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "class", "type", "max_level"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "class": { "type": "string" },
          "type": { "type": "string" },
          "max_level": { "type": "integer" },
          "animation": { "type": "string" },
          "cast_time_s": { "type": "number" },
          "hit_frame_s": { "type": "number" },
          "hitbox": { "type": "object" },
          "max_targets": { "type": "integer" },
          "hits": { "type": "integer" },
          "hit_spacing_s": { "type": "number" },
          "required_skills": { "type": "object" },
          "projectile": { "type": "object" },
          "levels": { "type": "object" },
          "knockback": {
            "type": "array",
            "items": { "type": "number" }
          },
          "buff": { "type": "object" }
        }
      }
    }
  }
}
